<?php
if ($_SERVER["REQUEST_METHOD"] == "POST") {

    $nama          = isset($_POST['nama']) ? htmlspecialchars(trim($_POST['nama'])) : '';
    $nim           = isset($_POST['nim']) ? htmlspecialchars(trim($_POST['nim'])) : '';
    $email         = isset($_POST['email']) ? filter_var(trim($_POST['email']), FILTER_SANITIZE_EMAIL) : '';
    $telepon       = isset($_POST['telepon']) ? htmlspecialchars(trim($_POST['telepon'])) : '';
    $prodi         = isset($_POST['prodi']) ? htmlspecialchars($_POST['prodi']) : '';
    $jenis_kelamin = isset($_POST['jenis_kelamin']) ? htmlspecialchars($_POST['jenis_kelamin']) : '';
    $alasan        = isset($_POST['alasan']) ? htmlspecialchars(trim($_POST['alasan'])) : '';
    $persetujuan   = isset($_POST['persetujuan']) ? true : false;

    $sesi_terpilih = array();
    if (isset($_POST['sesi']) && is_array($_POST['sesi'])) {
        foreach ($_POST['sesi'] as $s) {
            $sesi_terpilih[] = htmlspecialchars($s);
        }
    }

    $daftar_prodi = array(
        'si' => 'Sistem Informasi',
        'ti' => 'Teknik Informatika',
        'bd' => 'Bisnis Digital',
        'ak' => 'Akuntansi',
        'mb' => 'Manajemen'
    );
    $nama_prodi = array_key_exists($prodi, $daftar_prodi) ? $daftar_prodi[$prodi] : 'Tidak Diketahui';

    // Pemetaan Jenis Kelamin
    $nama_jk = ($jenis_kelamin == 'L') ? 'Laki-laki' : (($jenis_kelamin == 'P') ? 'Perempuan' : '-');

    // 2. Validasi Sederhana
    $errors = array();

    if (empty($nama)) $errors[] = "Nama Lengkap wajib diisi.";
    if (empty($nim)) $errors[] = "NIM wajib diisi.";
    if (empty($email) || !filter_var($email, FILTER_VALIDATE_EMAIL)) $errors[] = "Alamat Email tidak valid.";
    if (empty($telepon)) $errors[] = "Nomor Telepon wajib diisi.";
    if (empty($prodi)) $errors[] = "Program Studi wajib dipilih.";
    if (empty($jenis_kelamin)) $errors[] = "Jenis Kelamin wajib dipilih.";
    if (empty($sesi_terpilih)) $errors[] = "Pilih minimal satu sesi kegiatan.";
    if (!$persetujuan) $errors[] = "Anda harus menyetujui syarat dan ketentuan kegiatan.";

} else {
    header("Location: index.html");
    exit();
}
